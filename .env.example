# ---- Sitio ----
# URL pública del sitio (para metadata y la imagen OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Oferta ----
# Link real del producto en Hotmart (checkout específico, no la home de hotmart.com)
NEXT_PUBLIC_HOTMART_URL=
# Precio a mostrar en la landing — SOLO el número formateado (ej. "$47.00").
# La moneda va aparte, en NEXT_PUBLIC_PRECIO_MONEDA.
NEXT_PUBLIC_PRECIO=
# Sigla de moneda mostrada junto al precio (ej. "USD", "MXN").
NEXT_PUBLIC_PRECIO_MONEDA=
# Días de garantía de devolución. Vacío = no se muestra ninguna garantía.
NEXT_PUBLIC_GARANTIA_DIAS=
# Precio "anterior" tachado junto al precio actual, como texto ya formateado
# (ej. "$47 USD"). Solo poner un valor real que de verdad se cobró antes —
# vacío = no se muestra ningún tachado inventado.
NEXT_PUBLIC_PRECIO_ANTERIOR=
