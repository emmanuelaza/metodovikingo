# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server-side. NUNCA exponer al cliente. Se encuentra en Supabase →
# Project Settings → API → "service_role" secret (NO es la URL del proyecto).
# La app no la necesita para operar; déjala vacía salvo que agregues tareas admin.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sanity (opcional: si está vacío se usa el contenido local de content/) ----
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# ---- Reto ----
# Zona horaria para el corte diario del calendario (desbloqueo de días y racha)
RETO_TIMEZONE=America/Bogota
# URL pública del sitio (para la imagen de racha compartible)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Upsell final (Hotmart)
NEXT_PUBLIC_HOTMART_URL=https://hotmart.com/

# ---- Anuncios ----
# Apaga TODOS los anuncios con una sola variable
NEXT_PUBLIC_ADS_ENABLED=false
# adsense | adsterra
NEXT_PUBLIC_AD_PROVIDER=adsense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_MID=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
NEXT_PUBLIC_ADSTERRA_ZONE_ID=
