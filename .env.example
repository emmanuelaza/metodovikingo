# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server-side. NUNCA exponer al cliente. Se encuentra en Supabase →
# Project Settings → API → "service_role" secret (NO es la URL del proyecto).
# Necesaria solo para el cron de notificaciones push (app/api/cron/notificar),
# que recorre todos los perfiles saltándose RLS. El resto de la app no la usa.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sanity (opcional: si está vacío se usa el contenido local de content/) ----
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# ---- Reto ----
# Zona horaria para el corte diario del calendario (desbloqueo de días y racha)
RETO_TIMEZONE=America/Bogota
# URL pública del sitio (para la imagen de racha compartible)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Upsell final (Hotmart)
NEXT_PUBLIC_HOTMART_URL=https://hotmart.com/

# ---- Anuncios (Adsterra, Popunder + Social Bar en app/layout.tsx) ----
# Apaga TODOS los anuncios con una sola variable
NEXT_PUBLIC_ADS_ENABLED=false

# ---- Notificaciones push (Web Push nativo, sin Firebase) ----
# Genera el par con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@example.com
# Header secreto que valida las llamadas del cron de Vercel a /api/cron/notificar
CRON_SECRET=
